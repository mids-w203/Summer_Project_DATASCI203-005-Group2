# ---------------------------------------------------------------------------
# Data: version control is for code, not data (per assignment guidance).
# NOTE: files already committed stay tracked until you `git rm --cached` them.
# ---------------------------------------------------------------------------
# data/**/*.csv
data/**/*.tsv
data/**/*.xlsx
data/**/*.rds

# --- R / RStudio ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*_cache/
*_files/

# --- renv (keep renv.lock and settings tracked; ignore the local library) ---
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/python/
renv/sandbox/

# --- Rendered/transient output (keep source .Rmd and delivered .pdf tracked) ---
*.html
*.log
*.aux
*.tex

# --- OS / editor junk ---
.DS_Store
Thumbs.db
*~
.vscode/
.idea/
